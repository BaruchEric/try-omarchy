#!/usr/bin/ash

# This late hook runs after the writable qcow2-backed root is mounted at
# /new_root but before systemd starts.  It mutates only the isolated producer
# delta; the canonical raw rootfs remains read-only on the host.
run_latehook() {
    local producer nonce swap_uuid root
    producer="$(getarg omarchy.hibernate_producer)"
    [ "$producer" = "1" ] || return 0

    nonce="$(getarg omarchy.hibernate_nonce)"
    swap_uuid="$(getarg omarchy.hibernate_swap_uuid)"
    root=/new_root
    printf '%s' "$nonce" | grep -Eq '^[0-9a-f]{64}$' || {
        err 'hibernate stage: invalid producer nonce'
        return 1
    }
    [ "$swap_uuid" = "4c9a13d2-7c3a-4f2c-b6e1-5a3048610e8f" ] || {
        err 'hibernate stage: invalid swap UUID'
        return 1
    }

    mkdir -p \
        "$root/etc/modprobe.d" \
        "$root/etc/systemd/system/multi-user.target.wants" \
        "$root/usr/local/libexec" \
        "$root/var/lib/omarchy-hibernate"

    cat >"$root/etc/modprobe.d/90-omarchy-hibernate-virtio-gpu.conf" <<'EOF'
blacklist virtio_gpu
EOF
    cp /usr/local/libexec/omarchy-egl-renderer-probe \
        "$root/usr/local/libexec/omarchy-egl-renderer-probe"
    chmod 0755 "$root/usr/local/libexec/omarchy-egl-renderer-probe"

    # Remove the browser software-renderer force only in the derived delta.
    # The compositor starts after the resumed branch loads virtio_gpu.
    if [ -f "$root/usr/lib/environment.d/90-omarchy-web.conf" ]; then
        sed -i \
            -e '/^LIBGL_ALWAYS_SOFTWARE=/d' \
            -e '/^GALLIUM_DRIVER=/d' \
            -e '/^WLR_RENDERER_ALLOW_SOFTWARE=/d' \
            "$root/usr/lib/environment.d/90-omarchy-web.conf"
    fi

    printf '%s\n' "$nonce" >"$root/var/lib/omarchy-hibernate/nonce"
    printf '%s\n' "$swap_uuid" >"$root/var/lib/omarchy-hibernate/swap-uuid"
    printf 'armed\n' >"$root/var/lib/omarchy-hibernate/armed"

    cat >"$root/usr/local/libexec/omarchy-hibernate-producer" <<'EOF'
#!/usr/bin/bash
set -euo pipefail

state_dir=/var/lib/omarchy-hibernate
swap_device=/dev/vdb
nonce=$(<"$state_dir/nonce")
swap_uuid=$(<"$state_dir/swap-uuid")
source_boot_id_file="$state_dir/source-boot-id"

emit() {
  printf '\n%s\n' "$1" >/dev/ttyS0
}

fail_closed() {
  local code=${1:-producer-failed}
  emit "OMARCHY_HIBERNATION_FAILURE {\"schemaVersion\":1,\"code\":\"$code\",\"nonce\":\"$nonce\"}"
  sync
  systemctl --no-block poweroff --force --force || true
  exit 1
}

trap 'fail_closed producer-command-failed' ERR
[[ $nonce =~ ^[0-9a-f]{64}$ ]] || fail_closed invalid-nonce
[[ $swap_uuid == 4c9a13d2-7c3a-4f2c-b6e1-5a3048610e8f ]] || fail_closed invalid-swap-uuid
[[ ! -d /sys/module/virtio_gpu ]] || fail_closed gpu-bound-before-hibernate
grep -qw disk /sys/power/state || fail_closed kernel-hibernation-unavailable
source_boot_id=$(</proc/sys/kernel/random/boot_id)
printf '%s\n' "$source_boot_id" >"$source_boot_id_file"

udevadm settle --timeout=60
[[ -b $swap_device ]] || fail_closed swap-device-missing
swapoff "$swap_device" 2>/dev/null || true
mkswap --force --uuid "$swap_uuid" "$swap_device" >/dev/null
swapon "$swap_device"
[[ $(blkid -s UUID -o value "$swap_device") == "$swap_uuid" ]] || fail_closed swap-uuid-mismatch
read -r swap_major swap_minor < <(stat -Lc '0x%t 0x%T' "$swap_device")
printf -v resume_device '%d:%d' "$swap_major" "$swap_minor"
printf '%s' "$resume_device" >/sys/power/resume
[[ $(</sys/power/resume) == "$resume_device" ]] || fail_closed resume-device-mismatch

# Bound the uncompressed image request to half of guest RAM.  The separate
# 1536 MiB virtual swap device still leaves ample safety margin.
printf '%s\n' 536870912 >/sys/power/image_size
printf '%s\n' shutdown >/sys/power/disk
printf 'hibernating\n' >"$state_dir/armed"
sync
emit "OMARCHY_HIBERNATION_ENTER {\"schemaVersion\":1,\"nonce\":\"$nonce\",\"sourceBootId\":\"$source_boot_id\",\"swapUuid\":\"$swap_uuid\",\"gpuBoundAtHibernate\":false}"

# Enter swsusp directly from this still-running oneshot.  This avoids a
# hibernate.target isolation transaction stopping the calling service.  The
# write does not return in the producer process; execution continues here only
# after a fresh kernel/initramfs restores the image.
printf '%s\n' disk >/sys/power/state

dmesg >"$state_dir/post-resume-dmesg.log"
grep -Fq 'PM: Image loading done' "$state_dir/post-resume-dmesg.log" \
  || fail_closed missing-image-load-proof
grep -Fq 'PM: hibernation: Hibernation image restored successfully.' \
  "$state_dir/post-resume-dmesg.log" \
  || fail_closed missing-restore-proof
[[ ! -d /sys/module/virtio_gpu ]] || fail_closed gpu-restored-from-image
[[ $(</proc/sys/kernel/random/boot_id) == "$source_boot_id" ]] || fail_closed boot-id-mismatch

rm -f /etc/modprobe.d/90-omarchy-hibernate-virtio-gpu.conf
modprobe virtio_gpu
for _attempt in $(seq 1 120); do
  [[ -e /dev/dri/renderD128 ]] && break
  sleep 1
done
[[ -e /dev/dri/renderD128 ]] || fail_closed render-node-missing
dmesg >"$state_dir/post-resume-dmesg.log"
grep -Eq '\[drm\] features:.*\+virgl' "$state_dir/post-resume-dmesg.log" \
  || fail_closed virgl-feature-missing
/usr/local/libexec/omarchy-egl-renderer-probe >"$state_dir/renderer-probe.json" \
  || fail_closed fresh-virgl-context-failed
grep -Eiq '"renderer":"[^"]*virgl' "$state_dir/renderer-probe.json" \
  || fail_closed renderer-identity-missing
renderer_report=$(<"$state_dir/renderer-probe.json")

printf 'resumed\n' >"$state_dir/resumed"
rm -f "$state_dir/armed"
sync
emit "OMARCHY_RENDERER_REPORT $renderer_report"
emit "OMARCHY_HIBERNATION_REPORT {\"schemaVersion\":1,\"status\":\"resumed\",\"nonce\":\"$nonce\",\"sourceBootId\":\"$source_boot_id\",\"swapUuid\":\"$swap_uuid\",\"gpuDriver\":\"virtio_gpu\",\"renderNode\":\"/dev/dri/renderD128\",\"renderer\":\"virgl\"}"
trap - ERR
EOF
    chmod 0755 "$root/usr/local/libexec/omarchy-hibernate-producer"

    cat >"$root/usr/local/libexec/omarchy-hibernate-fail-closed" <<'EOF'
#!/usr/bin/bash
set -euo pipefail
state_dir=/var/lib/omarchy-hibernate
nonce=$(<"$state_dir/nonce")
printf '\nOMARCHY_HIBERNATION_COLD_BOOT {"schemaVersion":1,"code":"cold-fallback","nonce":"%s"}\n' "$nonce" >/dev/ttyS0
sync
systemctl --no-block poweroff --force --force || true
EOF
    chmod 0755 "$root/usr/local/libexec/omarchy-hibernate-fail-closed"

    cat >"$root/etc/systemd/system/omarchy-hibernate-producer.service" <<'EOF'
[Unit]
Description=Produce an isolated Omarchy swsusp image
ConditionKernelCommandLine=omarchy.hibernate_producer=1
After=local-fs.target systemd-udev-settle.service
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/omarchy-hibernate-producer
RemainAfterExit=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
EOF

    cat >"$root/etc/systemd/system/omarchy-hibernate-fail-closed.service" <<'EOF'
[Unit]
Description=Reject a cold fallback when the hibernation image did not restore
ConditionPathExists=/var/lib/omarchy-hibernate/armed
ConditionKernelCommandLine=!omarchy.hibernate_producer=1
After=local-fs.target
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/omarchy-hibernate-fail-closed
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

    ln -sfn ../omarchy-hibernate-producer.service \
        "$root/etc/systemd/system/multi-user.target.wants/omarchy-hibernate-producer.service"
    ln -sfn ../omarchy-hibernate-fail-closed.service \
        "$root/etc/systemd/system/multi-user.target.wants/omarchy-hibernate-fail-closed.service"
}
