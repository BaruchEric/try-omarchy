#!/usr/bin/ash
# SPDX-License-Identifier: GPL-2.0-only

run_hook() {
    local resumedev noresume producer resume rootdelay target

    noresume="$(getarg noresume)"
    if [ -n "$noresume" ]; then
        return 0
    fi

    resume="$(getarg resume)"
    if [ -z "$resume" ]; then
        err 'resume: no device specified for hibernation'
        return 1
    fi

    if [ ! -e /sys/power/resume ]; then
        err 'resume: no hibernation support found'
        return 1
    fi

    rootdelay="$(getarg rootdelay)"
    if resumedev="$(resolve_device "$resume" "$rootdelay")"; then
        set -- $(stat -Lc '0x%t 0x%T' "$resumedev")
        [ "$#" -eq 2 ] || {
            err "resume: cannot determine device number for '$resumedev'"
            return 1
        }
        printf '%d:%d' "$1" "$2" >/sys/power/resume
        return 0
    fi

    # The producer's swap qcow2 is intentionally blank on its first boot; its
    # real-root oneshot formats it immediately before entering swsusp.  A fresh
    # target must never hide this condition: emit a bounded marker, continue to
    # the root delta, and let its armed fail-closed service power off.
    producer="$(getarg omarchy.hibernate_producer)"
    if [ "$producer" = "1" ]; then
        msg 'resume: producer swap is not formatted yet; continuing cold boot'
        return 0
    fi
    target="$(getarg omarchy.hibernate_target)"
    if [ "$target" = "1" ]; then
        printf '\nOMARCHY_HIBERNATION_COLD_BOOT {"schemaVersion":1,"code":"resume-device-unresolved"}\n' \
            >/dev/ttyS0
        return 0
    fi

    err "resume: hibernation device '$resume' not found"
    return 1
}
