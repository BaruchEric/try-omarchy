{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omarchy-web/artifact-manifest.schema.json",
  "title": "Omarchy browser demo artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "upstream",
    "runtime",
    "build",
    "guest",
    "artifacts",
    "licenses"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "Omarchy browser demo" },
    "upstream": {
      "type": "object",
      "required": ["repository", "commit", "version", "license"],
      "properties": {
        "repository": { "const": "https://github.com/basecamp/omarchy" },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "ref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license": { "const": "MIT" },
        "treeSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "name",
        "repository",
        "commit",
        "license",
        "modified",
        "correspondingSourceUrl"
      ],
      "properties": {
        "name": { "const": "qemu-wasm" },
        "repository": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "license": { "type": "string", "minLength": 1 },
        "modified": { "type": "boolean" },
        "correspondingSourceUrl": { "type": "string", "format": "uri" }
      }
    },
    "build": {
      "type": "object",
      "required": ["builtAt", "builderImageDigest", "sourceDateEpoch"],
      "properties": {
        "builtAt": { "type": "string", "format": "date-time" },
        "builderImageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "sourceDateEpoch": { "type": "integer", "minimum": 1 },
        "workflowUrl": { "type": "string", "format": "uri" }
      }
    },
    "guest": {
      "type": "object",
      "required": ["architecture", "distribution", "display"],
      "properties": {
        "architecture": { "const": "x86_64" },
        "distribution": { "const": "Arch Linux" },
        "display": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "const": 1600 },
            "height": { "const": 900 }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["path", "role", "bytes", "sha256", "mediaType"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "spdx", "noticePath", "sourceUrl"],
        "properties": {
          "component": { "type": "string", "minLength": 1 },
          "spdx": { "type": "string", "minLength": 1 },
          "noticePath": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
