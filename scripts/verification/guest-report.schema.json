{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omarchy-web/guest-report.schema.json",
  "title": "Omarchy guest authenticity report",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "provenance",
    "system",
    "components",
    "processes",
    "commands",
    "configs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "required": ["repository", "commit", "version", "treeSha256"],
      "properties": {
        "repository": { "const": "https://github.com/basecamp/omarchy" },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "version": { "type": "string", "minLength": 1 },
        "treeSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "imageSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "system": {
      "type": "object",
      "required": ["architecture", "distribution", "kernel", "sessionType"],
      "properties": {
        "architecture": { "const": "x86_64" },
        "distribution": { "const": "Arch Linux" },
        "kernel": { "type": "string", "minLength": 1 },
        "sessionType": { "const": "wayland" }
      }
    },
    "components": { "type": "array", "minItems": 2 },
    "processes": { "type": "array", "minItems": 2 },
    "commands": { "type": "array", "minItems": 4 },
    "configs": { "type": "array", "minItems": 1 }
  }
}
