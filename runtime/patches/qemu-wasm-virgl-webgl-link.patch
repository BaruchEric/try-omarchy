diff --git a/meson.build b/meson.build
index a86d8c1..ee0a383 100644
--- a/meson.build
+++ b/meson.build
@@ -3892,13 +3892,24 @@ foreach target : target_dirs
       exe_name += '-unsigned'
     endif
 
+    emulator_link_args = link_args
+    if host_arch == 'wasm32' and virgl.found() and opengl.found()
+      # VirGL's strict WebGL capability profile leaves desktop-only entry
+      # points unreachable. Preserve configure's fail-on-undefined behavior,
+      # but let the final experimental emulator link import those names; an
+      # accidental runtime call still traps instead of becoming a no-op.
+      emulator_link_args += ['-sERROR_ON_UNDEFINED_SYMBOLS=0',
+                             '-sWARN_ON_UNDEFINED_SYMBOLS=0',
+                             '-sOFFSCREENCANVASES_TO_PTHREAD=#canvas']
+    endif
+
     emulator = executable(exe_name, exe['sources'],
                install: true,
                c_args: c_args,
                dependencies: arch_deps + deps + exe['dependencies'],
                objects: lib.extract_all_objects(recursive: true),
                link_depends: [block_syms, qemu_syms] + exe.get('link_depends', []),
-               link_args: link_args,
+               link_args: emulator_link_args,
                win_subsystem: exe['win_subsystem'])
 
     if targetos == 'darwin'
