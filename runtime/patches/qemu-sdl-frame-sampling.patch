--- a/ui/sdl2-2d.c
+++ b/ui/sdl2-2d.c
@@ -27,8 +27,142 @@
 #include "ui/console.h"
 #include "ui/input.h"
 #include "ui/sdl2.h"
 #ifdef __EMSCRIPTEN__
 #include <emscripten.h>
+#include "qemu/atomic.h"
+
+#define OMARCHY_FRAME_SAMPLE_COLUMNS 32
+#define OMARCHY_FRAME_SAMPLE_ROWS 18
+#define OMARCHY_FRAME_SAMPLE_COUNT \
+    (OMARCHY_FRAME_SAMPLE_COLUMNS * OMARCHY_FRAME_SAMPLE_ROWS)
+#define OMARCHY_DESKTOP_WIDTH 1600
+#define OMARCHY_DESKTOP_HEIGHT 900
+#define OMARCHY_DESKTOP_MIN_CHANGED_PIXELS 29
+#define OMARCHY_DESKTOP_MAX_DOMINANT_PIXELS 547
+
+enum OmarchyDesktopProofState {
+    OMARCHY_DESKTOP_PROOF_IDLE = 0,
+    OMARCHY_DESKTOP_PROOF_AWAITING_BASELINE = 1,
+    OMARCHY_DESKTOP_PROOF_BASELINE_CAPTURED = 2,
+    OMARCHY_DESKTOP_PROOF_AWAITING_RESPONSE = 3,
+    OMARCHY_DESKTOP_PROOF_RESPONSE_CAPTURED = 4,
+};
+
+enum OmarchyDesktopProofFrame {
+    OMARCHY_DESKTOP_PROOF_FRAME_NONE = 0,
+    OMARCHY_DESKTOP_PROOF_FRAME_BASELINE = 1,
+    OMARCHY_DESKTOP_PROOF_FRAME_RESPONSE = 2,
+};
+
+static int omarchy_desktop_proof_state;
+static uint32_t omarchy_desktop_baseline[OMARCHY_FRAME_SAMPLE_COUNT];
+
+static uint8_t omarchy_scale_component(uint32_t pixel, uint32_t mask,
+                                       uint8_t shift, uint8_t maximum)
+{
+    uint32_t component = (pixel & mask) >> shift;
+
+    return (component * 255 + maximum / 2) / maximum;
+}
+
+static int omarchy_sample_guest_surface(
+    DisplaySurface *surface,
+    uint32_t samples[OMARCHY_FRAME_SAMPLE_COUNT],
+    int *non_black_pixels)
+{
+    PixelFormat format = qemu_pixelformat_from_pixman(surface_format(surface));
+    const int width = surface_width(surface);
+    const int height = surface_height(surface);
+    const int bytes_per_pixel = surface_bytes_per_pixel(surface);
+    const uint8_t *data = surface_data(surface);
+    int sampled = 0;
+    int non_black = 0;
+
+    if (!data || width <= 0 || height <= 0 || bytes_per_pixel <= 0 ||
+        bytes_per_pixel > 4 || !format.rmax || !format.gmax || !format.bmax) {
+        *non_black_pixels = 0;
+        return 0;
+    }
+
+    for (int row = 0; row < OMARCHY_FRAME_SAMPLE_ROWS; row++) {
+        const int y = row * (height - 1) / (OMARCHY_FRAME_SAMPLE_ROWS - 1);
+        const uint8_t *line = data + y * surface_stride(surface);
+
+        for (int column = 0; column < OMARCHY_FRAME_SAMPLE_COLUMNS; column++) {
+            const int x = column * (width - 1) /
+                          (OMARCHY_FRAME_SAMPLE_COLUMNS - 1);
+            uint32_t pixel = 0;
+            uint32_t rgb;
+
+            memcpy(&pixel, line + x * bytes_per_pixel, bytes_per_pixel);
+            rgb = (omarchy_scale_component(pixel, format.rmask, format.rshift,
+                                           format.rmax) << 16) |
+                  (omarchy_scale_component(pixel, format.gmask, format.gshift,
+                                           format.gmax) << 8) |
+                  omarchy_scale_component(pixel, format.bmask, format.bshift,
+                                          format.bmax);
+            samples[sampled++] = rgb;
+            if (rgb) {
+                non_black++;
+            }
+        }
+    }
+
+    *non_black_pixels = non_black;
+    return sampled;
+}
+
+static int omarchy_count_dominant_pixels(
+    const uint32_t samples[OMARCHY_FRAME_SAMPLE_COUNT])
+{
+    int dominant = 0;
+
+    for (int i = 0; i < OMARCHY_FRAME_SAMPLE_COUNT; i++) {
+        int count = 1;
+        bool already_counted = false;
+
+        for (int previous = 0; previous < i; previous++) {
+            if (samples[previous] == samples[i]) {
+                already_counted = true;
+                break;
+            }
+        }
+        if (already_counted) {
+            continue;
+        }
+        for (int following = i + 1; following < OMARCHY_FRAME_SAMPLE_COUNT;
+             following++) {
+            if (samples[following] == samples[i]) {
+                count++;
+            }
+        }
+        dominant = MAX(dominant, count);
+    }
+    return dominant;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int omarchy_desktop_proof_arm(void)
+{
+    if (qatomic_read(&omarchy_desktop_proof_state) !=
+        OMARCHY_DESKTOP_PROOF_IDLE) {
+        return -1;
+    }
+    memset(omarchy_desktop_baseline, 0, sizeof(omarchy_desktop_baseline));
+    return qatomic_cmpxchg(&omarchy_desktop_proof_state,
+                           OMARCHY_DESKTOP_PROOF_IDLE,
+                           OMARCHY_DESKTOP_PROOF_AWAITING_BASELINE) ==
+                           OMARCHY_DESKTOP_PROOF_IDLE ? 0 : -2;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int omarchy_desktop_proof_expect_response(void)
+{
+    return qatomic_cmpxchg(&omarchy_desktop_proof_state,
+                           OMARCHY_DESKTOP_PROOF_BASELINE_CAPTURED,
+                           OMARCHY_DESKTOP_PROOF_AWAITING_RESPONSE) ==
+                           OMARCHY_DESKTOP_PROOF_BASELINE_CAPTURED ? 0 : -1;
+}
 #endif
 
 void sdl2_2d_update(DisplayChangeListener *dcl,
@@ -43,6 +177,13 @@
     assert(!scon->opengl);
 
 #ifdef __EMSCRIPTEN__
+    uint32_t samples[OMARCHY_FRAME_SAMPLE_COUNT];
+    int sampled_pixels;
+    int non_black_pixels;
+    int proof_frame = OMARCHY_DESKTOP_PROOF_FRAME_NONE;
+    int changed_pixels = 0;
+    int dominant_pixels = 0;
+
     if (!first_update_reported) {
         fprintf(stderr,
                 "OMARCHY_RUNTIME_DIAGNOSTIC sdl-update-entered x=%d y=%d width=%d height=%d texture=%p renderer=%p\n",
@@ -82,12 +223,45 @@
         fflush(stderr);
         first_present_reported = true;
     }
+    sampled_pixels = omarchy_sample_guest_surface(
+        scon->surface, samples, &non_black_pixels);
+    if (sampled_pixels == OMARCHY_FRAME_SAMPLE_COUNT &&
+        surface_width(scon->surface) == OMARCHY_DESKTOP_WIDTH &&
+        surface_height(scon->surface) == OMARCHY_DESKTOP_HEIGHT) {
+        int proof_state = qatomic_read(&omarchy_desktop_proof_state);
+
+        if (proof_state == OMARCHY_DESKTOP_PROOF_AWAITING_BASELINE) {
+            memcpy(omarchy_desktop_baseline, samples,
+                   sizeof(omarchy_desktop_baseline));
+            qatomic_set(&omarchy_desktop_proof_state,
+                        OMARCHY_DESKTOP_PROOF_BASELINE_CAPTURED);
+            proof_frame = OMARCHY_DESKTOP_PROOF_FRAME_BASELINE;
+        } else if (proof_state == OMARCHY_DESKTOP_PROOF_AWAITING_RESPONSE) {
+            for (int index = 0; index < OMARCHY_FRAME_SAMPLE_COUNT; index++) {
+                if (samples[index] != omarchy_desktop_baseline[index]) {
+                    changed_pixels++;
+                }
+            }
+            dominant_pixels = omarchy_count_dominant_pixels(samples);
+            if (changed_pixels >= OMARCHY_DESKTOP_MIN_CHANGED_PIXELS &&
+                dominant_pixels >= 1 &&
+                dominant_pixels <= OMARCHY_DESKTOP_MAX_DOMINANT_PIXELS &&
+                qatomic_cmpxchg(&omarchy_desktop_proof_state,
+                    OMARCHY_DESKTOP_PROOF_AWAITING_RESPONSE,
+                    OMARCHY_DESKTOP_PROOF_RESPONSE_CAPTURED) ==
+                    OMARCHY_DESKTOP_PROOF_AWAITING_RESPONSE) {
+                proof_frame = OMARCHY_DESKTOP_PROOF_FRAME_RESPONSE;
+            }
+        }
+    }
     /* This callback runs only after QEMU presents its guest display surface. */
     MAIN_THREAD_ASYNC_EM_ASM({
         if (typeof Module !== 'undefined' && Module['onGuestFrame']) {
-            Module['onGuestFrame']($0, $1);
+            Module['onGuestFrame']($0, $1, $2, $3, $4, $5, $6);
         }
-    }, surface_width(scon->surface), surface_height(scon->surface));
+    }, surface_width(scon->surface), surface_height(scon->surface),
+       sampled_pixels, non_black_pixels, proof_frame, changed_pixels,
+       dominant_pixels);
 #endif
 }
 
