+enum omarchy_wasm_tcg_capacity_block {
+    OMARCHY_WASM_TCG_CAPACITY_AVAILABLE = 0,
+    OMARCHY_WASM_TCG_ACTIVE_CAPACITY_BLOCKED,
+    OMARCHY_WASM_TCG_RETAINED_CAPACITY_BLOCKED,
+};
+
+static enum omarchy_wasm_tcg_capacity_block instance_capacity_block(void)
+{
+    if (qatomic_read(&instance_running_global) >= MAX_INSTANCE_ACTIVE) {
+        return OMARCHY_WASM_TCG_ACTIVE_CAPACITY_BLOCKED;
+    }
+    if (qatomic_read(&instance_alive_global) >= MAX_INSTANCE_RETAINED) {
+        return OMARCHY_WASM_TCG_RETAINED_CAPACITY_BLOCKED;
+    }
+    return OMARCHY_WASM_TCG_CAPACITY_AVAILABLE;
+}
+
 static bool can_add_instance()
 {
-    return qatomic_read(&instance_alive_global) < MAX_INSTANCE_ALIVE;
+    return instance_capacity_block() == OMARCHY_WASM_TCG_CAPACITY_AVAILABLE;
+}
+
+static enum omarchy_wasm_tcg_capacity_block try_reserve_instance(void)
+{
+    int active_before = qatomic_fetch_inc(&instance_running_global);
+    if (active_before >= MAX_INSTANCE_ACTIVE) {
+        qatomic_dec(&instance_running_global);
+        omarchy_wasm_tcg_metrics.active_capacity_denials++;
+        return OMARCHY_WASM_TCG_ACTIVE_CAPACITY_BLOCKED;
+    }
+
+    int retained_before = qatomic_fetch_inc(&instance_alive_global);
+    if (retained_before >= MAX_INSTANCE_RETAINED) {
+        qatomic_dec(&instance_alive_global);
+        qatomic_dec(&instance_running_global);
+        omarchy_wasm_tcg_metrics.retained_capacity_denials++;
+        return OMARCHY_WASM_TCG_RETAINED_CAPACITY_BLOCKED;
+    }
+
+    int active_global = active_before + 1;
+    int retained_global = retained_before + 1;
+    int pending_global = qatomic_read(&instance_pending_gc_global);
+    omarchy_wasm_tcg_metrics.replacement_reservations += pending_global > 0;
+    omarchy_wasm_tcg_metrics.active_global_peak =
+        MAX(omarchy_wasm_tcg_metrics.active_global_peak, active_global);
+    omarchy_wasm_tcg_metrics.retained_global_peak =
+        MAX(omarchy_wasm_tcg_metrics.retained_global_peak, retained_global);
+    omarchy_wasm_tcg_metrics.pending_global_peak =
+        MAX(omarchy_wasm_tcg_metrics.pending_global_peak, pending_global);
+    return OMARCHY_WASM_TCG_CAPACITY_AVAILABLE;
+}
+
+static int reserve_retirement_slots(int requested)
+{
+    int pending;
+    int reserved;
+
+    do {
+        pending = qatomic_read(&instance_pending_gc_global);
+        reserved = MIN(requested,
+                       MAX_INSTANCE_REPLACEMENT_CREDIT - pending);
+        if (reserved <= 0) {
+            return 0;
+        }
+    } while (qatomic_cmpxchg(&instance_pending_gc_global,
+                             pending, pending + reserved) != pending);
+
+    return reserved;
 }
 
