+static bool omarchy_performance_is_syn_report(
+    const virtio_input_event *event)
+{
+    return event->type == cpu_to_le16(EV_SYN) &&
+           event->code == cpu_to_le16(SYN_REPORT);
+}
+
+void omarchy_performance_input_capture_begin(void)
+{
+    omarchy_performance_input_capture_active = true;
+    omarchy_performance_receipt_handle = 0;
+    omarchy_performance_input_event_count = 0;
+    omarchy_performance_input_drop_count = 0;
+    omarchy_performance_receipt_report_seen = false;
+    omarchy_performance_receipt_report_failed = false;
+}
+
+void omarchy_performance_input_capture_end(void)
+{
+    if (omarchy_performance_receipt_handle != 0) {
+        omarchy_performance_input_drop_count++;
+    }
+    omarchy_performance_input_capture_active = false;
+    omarchy_performance_receipt_handle = 0;
+    omarchy_performance_receipt_report_seen = false;
+    omarchy_performance_receipt_report_failed = false;
+}
+
+void omarchy_performance_input_receipt_begin(uint32_t receipt_handle)
+{
+    if (!omarchy_performance_input_capture_active || receipt_handle == 0 ||
+        omarchy_performance_receipt_handle != 0) {
+        if (omarchy_performance_input_capture_active) {
+            omarchy_performance_input_drop_count++;
+        }
+        return;
+    }
+    omarchy_performance_receipt_handle = receipt_handle;
+    omarchy_performance_receipt_report_seen = false;
+    omarchy_performance_receipt_report_failed = false;
+}
+
+void omarchy_performance_input_receipt_end(uint32_t receipt_handle)
+{
+    int delivered;
+
+    if (!omarchy_performance_input_capture_active || receipt_handle == 0 ||
+        receipt_handle != omarchy_performance_receipt_handle ||
+        !omarchy_performance_receipt_report_seen ||
+        omarchy_performance_receipt_report_failed) {
+        if (omarchy_performance_input_capture_active) {
+            omarchy_performance_input_drop_count++;
+        }
+        omarchy_performance_receipt_handle = 0;
+        omarchy_performance_receipt_report_seen = false;
+        omarchy_performance_receipt_report_failed = false;
+        return;
+    }
+    delivered = MAIN_THREAD_EM_ASM_INT({
+        const callback = typeof Module !== 'undefined'
+            ? Module['onBrowserPerformanceInputDelivered']
+            : null;
+        if (typeof callback !== 'function') {
+            return 0;
+        }
+        try {
+            return callback($0) === true ? 1 : 0;
+        } catch (_error) {
+            return 0;
+        }
+    }, receipt_handle);
+    if (delivered) {
+        omarchy_performance_input_event_count++;
+    } else {
+        omarchy_performance_input_drop_count++;
+    }
+    omarchy_performance_receipt_handle = 0;
+    omarchy_performance_receipt_report_seen = false;
+    omarchy_performance_receipt_report_failed = false;
+}
