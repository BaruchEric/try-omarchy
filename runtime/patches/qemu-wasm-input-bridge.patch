--- a/ui/sdl2.c
+++ b/ui/sdl2.c
@@ -34,6 +34,9 @@
 #include "sysemu/sysemu.h"
 #include "ui/win32-kbd-hook.h"
 #include "qemu/log.h"
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
 
 static int sdl2_num_outputs;
 static struct sdl2_console *sdl2_console;
@@ -61,6 +64,149 @@
 /* introduced in SDL 2.0.10 */
 #ifndef SDL_HINT_RENDER_BATCHING
 #define SDL_HINT_RENDER_BATCHING "SDL_RENDER_BATCHING"
+#endif
+
+#ifdef __EMSCRIPTEN__
+static int omarchy_input_window_id(uint32_t *window_id)
+{
+    if (!sdl2_console || sdl2_num_outputs < 1 ||
+        !sdl2_console[0].real_window) {
+        return -1;
+    }
+    *window_id = SDL_GetWindowID(sdl2_console[0].real_window);
+    return *window_id ? 0 : -2;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int omarchy_input_key(int scancode, int down)
+{
+    static bool first_key_reported;
+    SDL_Event event = { 0 };
+    uint32_t window_id;
+
+    if (scancode <= SDL_SCANCODE_UNKNOWN || scancode >= SDL_NUM_SCANCODES ||
+        (down != 0 && down != 1)) {
+        return -3;
+    }
+    if (omarchy_input_window_id(&window_id) != 0) {
+        return -1;
+    }
+    event.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+    event.key.type = event.type;
+    event.key.windowID = window_id;
+    event.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+    event.key.repeat = 0;
+    event.key.keysym.scancode = scancode;
+    if (SDL_PushEvent(&event) != 1) {
+        return -4;
+    }
+    if (!first_key_reported) {
+        fprintf(stderr,
+                "OMARCHY_RUNTIME_DIAGNOSTIC input-key-queued scancode=%d down=%d\n",
+                scancode, down);
+        fflush(stderr);
+        first_key_reported = true;
+    }
+    return 0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int omarchy_input_pointer(int normalized_x, int normalized_y,
+                          unsigned int buttons)
+{
+    static bool first_pointer_reported;
+    static unsigned int previous_buttons;
+    SDL_Event event = { 0 };
+    uint32_t window_id;
+    int width;
+    int height;
+    int x;
+    int y;
+
+    if (normalized_x < 0 || normalized_x > 32767 ||
+        normalized_y < 0 || normalized_y > 32767 || buttons > 31) {
+        return -3;
+    }
+    if (omarchy_input_window_id(&window_id) != 0) {
+        return -1;
+    }
+    SDL_GetWindowSize(sdl2_console[0].real_window, &width, &height);
+    if (width < 1 || height < 1) {
+        return -2;
+    }
+    x = (int)((int64_t)normalized_x * (width - 1) / 32767);
+    y = (int)((int64_t)normalized_y * (height - 1) / 32767);
+    event.type = SDL_MOUSEMOTION;
+    event.motion.type = SDL_MOUSEMOTION;
+    event.motion.windowID = window_id;
+    event.motion.state = buttons;
+    event.motion.x = x;
+    event.motion.y = y;
+    if (SDL_PushEvent(&event) != 1) {
+        return -4;
+    }
+    for (unsigned int button = SDL_BUTTON_LEFT;
+         button <= SDL_BUTTON_X2; button++) {
+        unsigned int mask = SDL_BUTTON(button);
+
+        if ((buttons & mask) == (previous_buttons & mask)) {
+            continue;
+        }
+        event = (SDL_Event) { 0 };
+        event.type = buttons & mask ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+        event.button.type = event.type;
+        event.button.windowID = window_id;
+        event.button.button = button;
+        event.button.state = buttons & mask ? SDL_PRESSED : SDL_RELEASED;
+        event.button.clicks = 1;
+        event.button.x = x;
+        event.button.y = y;
+        if (SDL_PushEvent(&event) != 1) {
+            return -4;
+        }
+    }
+    previous_buttons = buttons;
+    if (!first_pointer_reported) {
+        fprintf(stderr,
+                "OMARCHY_RUNTIME_DIAGNOSTIC input-pointer-queued x=%d y=%d buttons=%u\n",
+                normalized_x, normalized_y, buttons);
+        fflush(stderr);
+        first_pointer_reported = true;
+    }
+    return 0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int omarchy_input_wheel(int horizontal, int vertical)
+{
+    static bool first_wheel_reported;
+    SDL_Event event = { 0 };
+    uint32_t window_id;
+
+    if (horizontal < -1 || horizontal > 1 || vertical < -1 || vertical > 1 ||
+        (horizontal == 0 && vertical == 0)) {
+        return -3;
+    }
+    if (omarchy_input_window_id(&window_id) != 0) {
+        return -1;
+    }
+    event.type = SDL_MOUSEWHEEL;
+    event.wheel.type = SDL_MOUSEWHEEL;
+    event.wheel.windowID = window_id;
+    event.wheel.x = horizontal;
+    event.wheel.y = vertical;
+    if (SDL_PushEvent(&event) != 1) {
+        return -4;
+    }
+    if (!first_wheel_reported) {
+        fprintf(stderr,
+                "OMARCHY_RUNTIME_DIAGNOSTIC input-wheel-queued x=%d y=%d\n",
+                horizontal, vertical);
+        fflush(stderr);
+        first_wheel_reported = true;
+    }
+    return 0;
+}
 #endif
 
 static void sdl_update_caption(struct sdl2_console *scon);
