+SDL_GLContext sdl2_gl_window_context_create(struct sdl2_console *scon)
+{
+#ifdef __EMSCRIPTEN__
+    EmscriptenWebGLContextAttributes attrs;
+    EMSCRIPTEN_WEBGL_CONTEXT_HANDLE ctx;
+    EMSCRIPTEN_RESULT result;
+
+    (void)scon;
+    emscripten_webgl_init_context_attributes(&attrs);
+    attrs.alpha = EM_FALSE;
+    attrs.depth = EM_TRUE;
+    attrs.stencil = EM_TRUE;
+    attrs.antialias = EM_FALSE;
+    attrs.premultipliedAlpha = EM_FALSE;
+    attrs.preserveDrawingBuffer = EM_FALSE;
+    attrs.powerPreference = EM_WEBGL_POWER_PREFERENCE_HIGH_PERFORMANCE;
+    attrs.failIfMajorPerformanceCaveat = EM_TRUE;
+    attrs.majorVersion = 2;
+    attrs.minorVersion = 0;
+    attrs.enableExtensionsByDefault = EM_FALSE;
+    attrs.explicitSwapControl = EM_TRUE;
+    attrs.proxyContextToMainThread = EMSCRIPTEN_WEBGL_CONTEXT_PROXY_DISALLOW;
+    attrs.renderViaOffscreenBackBuffer = EM_FALSE;
+
+    ctx = emscripten_webgl_create_context("#canvas", &attrs);
+    if (ctx <= 0) {
+        fprintf(stderr, "OMARCHY_RUNTIME_DIAGNOSTIC "
+                "webgl2-context-create-failed result=%ld\n", (long)ctx);
+        return NULL;
+    }
+    result = emscripten_webgl_make_context_current(ctx);
+    if (result != EMSCRIPTEN_RESULT_SUCCESS) {
+        fprintf(stderr, "OMARCHY_RUNTIME_DIAGNOSTIC "
+                "webgl2-context-current-failed result=%d\n", result);
+        emscripten_webgl_destroy_context(ctx);
+        return NULL;
+    }
+    fprintf(stderr, "OMARCHY_RUNTIME_DIAGNOSTIC "
+            "webgl2-context-created handle=%ld proxy=disallow\n", (long)ctx);
+    return (SDL_GLContext)(intptr_t)ctx;
+#else
+    return SDL_GL_CreateContext(scon->real_window);
+#endif
+}
+
+void sdl2_gl_window_context_destroy(SDL_GLContext ctx)
+{
+#ifdef __EMSCRIPTEN__
+    EMSCRIPTEN_WEBGL_CONTEXT_HANDLE handle = (intptr_t)ctx;
+
+    if (handle > 0) {
+        emscripten_webgl_destroy_context(handle);
+    }
+#else
+    SDL_GL_DeleteContext(ctx);
+#endif
+}
+
+int sdl2_gl_window_context_make_current(struct sdl2_console *scon,
+                                        SDL_GLContext ctx)
+{
+#ifdef __EMSCRIPTEN__
+    EMSCRIPTEN_WEBGL_CONTEXT_HANDLE handle = (intptr_t)ctx;
+
+    (void)scon;
+    return emscripten_webgl_make_context_current(handle) ==
+           EMSCRIPTEN_RESULT_SUCCESS ? 0 : -1;
+#else
+    return SDL_GL_MakeCurrent(scon->real_window, ctx);
+#endif
+}
+
+void sdl2_gl_window_context_swap(struct sdl2_console *scon)
+{
+#ifdef __EMSCRIPTEN__
+    EMSCRIPTEN_RESULT result = emscripten_webgl_commit_frame();
+
+    (void)scon;
+    if (result != EMSCRIPTEN_RESULT_SUCCESS) {
+        fprintf(stderr, "OMARCHY_RUNTIME_DIAGNOSTIC "
+                "webgl2-frame-commit-failed result=%d\n", result);
+    }
+#else
+    SDL_GL_SwapWindow(scon->real_window);
+#endif
+}
