{
  "schemaVersion": 1,
  "name": "QEMU-Wasm SDL firmware smoke",
  "display": {
    "width": 1600,
    "height": 900,
    "devicePixelRatioCap": 2
  },
  "assets": {
    "module": "qemu.mjs",
    "preload": "load.js",
    "data": "qemu.data",
    "locate": {
      "qemu-system-x86_64.wasm": "qemu.wasm",
      "qemu-system-x86_64.worker.js": "qemu.worker.js"
    }
  },
  "guest": {
    "requiredFiles": []
  },
  "qemu": {
    "memoryMiB": 512,
    "cores": 1,
    "arguments": [
      "-machine",
      "q35",
      "-m",
      "512M",
      "-accel",
      "tcg,tb-size=128,thread=multi",
      "-smp",
      "1,sockets=1,cores=1,threads=1",
      "-L",
      "/pack",
      "-bios",
      "/pack/bios-256k.bin",
      "-display",
      "sdl,gl=off,show-cursor=on",
      "-vga",
      "std",
      "-device",
      "virtio-keyboard-pci",
      "-device",
      "virtio-tablet-pci",
      "-boot",
      "order=c,strict=on",
      "-serial",
      "stdio",
      "-monitor",
      "none",
      "-nic",
      "none",
      "-no-reboot"
    ]
  }
}
