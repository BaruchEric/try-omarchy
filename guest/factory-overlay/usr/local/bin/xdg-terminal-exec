#!/bin/bash
# Minimal xdg-terminal-exec compatibility for the pinned Foot terminal.
set -euo pipefail

app_id=""
title=""
directory=""
command=()

while (($#)); do
  case "$1" in
    --print-id)
      printf 'foot.desktop\n'
      exit 0
      ;;
    --app-id)
      app_id=${2:-}
      shift 2
      ;;
    --app-id=*)
      app_id=${1#*=}
      shift
      ;;
    --title)
      title=${2:-}
      shift 2
      ;;
    --title=*)
      title=${1#*=}
      shift
      ;;
    --dir)
      directory=${2:-}
      shift 2
      ;;
    --dir=*)
      directory=${1#*=}
      shift
      ;;
    -e|--)
      shift
      command=("$@")
      break
      ;;
    *)
      command=("$@")
      break
      ;;
  esac
done

args=()
[[ -z $app_id ]] || args+=(--app-id "$app_id")
[[ -z $title ]] || args+=(--title "$title")
[[ -z $directory ]] || args+=(--working-directory "$directory")
if ((${#command[@]})); then
  args+=("${command[@]}")
fi
exec /usr/bin/foot "${args[@]}"
