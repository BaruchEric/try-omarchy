[Unit]
Description=Observe Omarchy startup and emit live browser-demo authenticity evidence

[Service]
Type=simple
ExecStart=/usr/local/bin/omarchy-web-guest-probe --watch
RemainAfterExit=yes
Nice=19
IOSchedulingClass=idle
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin
Environment=PYTHONNOUSERSITE=1
UnsetEnvironment=LD_AUDIT LD_DEBUG LD_LIBRARY_PATH LD_PRELOAD PYTHONHOME PYTHONPATH
Restart=on-failure
RestartSec=5s
