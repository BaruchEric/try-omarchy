{
  // Browser-demo customization using Omarchy's supported menu extension API.
  // The menu implementation and all retained entries are the upstream shell.
  "demo": {"icon":"󰖟","label":"Try Omarchy"},
  "demo.welcome": {"icon":"󰋼","label":"Demo guide","action":"uwsm-app -- chromium --app=file:///usr/share/omarchy-web/welcome/index.html"},
  "demo.terminal": {"icon":"","label":"Terminal","action":"omarchy-launch-terminal"},
  "demo.files": {"icon":"","label":"Files","action":"omarchy-launch-nautilus"},
  "demo.editor": {"icon":"","label":"Neovim","action":"omarchy-launch-editor"},

  // These workflows require physical hardware, privileged installation, or a
  // durable machine. Hiding a root entry also hides its descendants.
  "install": {"when":"false"},
  "remove": {"when":"false"},
  "setup": {"when":"false"},
  "system": {"when":"false"},
  "update": {"when":"false"},
  "trigger.hardware": {"when":"false"},
  "trigger.share": {"when":"false"},
  "trigger.tests": {"when":"false"},
  "style.unlock": {"when":"false"},

  // The release runtime intentionally has no guest network. Retain Omarchy's
  // local manuals/keybinding views and hide links that would only show an
  // offline Chromium error page.
  "learn.arch": {"when":"false"},
  "learn.community": {"when":"false"},
  "learn.hyprland": {"when":"false"},
  "learn.neovim": {"when":"false"},
  "learn.omarchy": {"when":"false"}
}
